#: data/gnome-disk-image-mounter.desktop.in:2
msgid "Disk Image Mounter"
msgstr "Диск бейнелерін тіркеуші"

#: data/gnome-disk-image-mounter.desktop.in:3
msgid "Mount/Write Disk Images"
msgstr "Диск бейнелерін тіркеу/жазу"

#: data/org.gnome.Disks.gschema.xml:6
msgid "Default location for the Create/Restore disk image dialogs"
msgstr "Диск бейнелерін жасау/қалпына келтіру сұхбаты үшін негізгі сақтау орны"

#: data/org.gnome.Disks.gschema.xml:7
msgid "Default location for the Create/Restore disk image dialogs. If blank the ~/Documents folder is used."
msgstr "Диск бейнелерін жасау/қалпына келтіру сұхбаты үшін негізгі сақтау орны. Бос болса, ~/Құжаттар бумасы қолданылатын болады."

#: data/org.gnome.Disks.gschema.xml:13
msgid "Initial state of the window"
msgstr "Терезенің бастапқы қалып-күйі"

#: data/org.gnome.Disks.gschema.xml:14
msgid "A tuple containing the initial width, height and maximize state of the app window."
msgstr "Қолданба терезесінің бастапқы ені, биіктігі және максималды қалып-күйін қамтитын кортеж."

#: data/org.gnome.Disks.gschema.xml:20
msgid "The number of samples the benchmark will include for the read/write test."
msgstr "Бенчмарк оқу/жазу сынағы үшін қамтитын үлгілер саны."

#: data/org.gnome.Disks.gschema.xml:24
msgid "The number of MiB (1048576 bytes) to read/write for each sample."
msgstr "Әр үлгі үшін оқуға/жазуға арналған МиБ (1048576 байт) саны."

#: data/org.gnome.Disks.gschema.xml:28
msgid "To enable or disable the write test."
msgstr "Жазу сынағын іске қосу немесе сөндіру үшін."

#: data/org.gnome.Disks.gschema.xml:32
msgid "The number of samples the benchmark will do for the access time test."
msgstr "Бенчмарк қол жеткізу уақыты сынағы үшін жасайтын үлгілер саны."

#: data/org.gnome.DiskUtility.desktop.in:2 data/org.gnome.DiskUtility.metainfo.xml.in:7 src/disks/gdu-application.c:307 src/notify/gdusdmonitor.c:241
#: src/resources/ui/gdu-window.blp:21
msgid "Disks"
msgstr "Дисктер"

#: data/org.gnome.DiskUtility.desktop.in:3
msgid "Manage Drives and Media"
msgstr "Дисктер мен тасушыларды басқару"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.DiskUtility.desktop.in:5
msgid "disk;drive;volume;harddisk;hdd;disc;cdrom;dvd;partition;iso;image;backup;restore;benchmark;raid;luks;encryption;S.M.A.R.T.;smart;"
msgstr ""
"disk;drive;volume;harddisk;hdd;disc;cdrom;dvd;partition;iso;image;backup;restore;benchmark;raid;luks;encryption;S.M.A.R.T.;smart;диск;жетек;том;бөлім;қатты "
"диск;сд;бейне;қор көшірме;қалпына келтіру;сынау;шифрлеу;смарт;"

#: data/org.gnome.DiskUtility.metainfo.xml.in:8
msgid "Disk management utility for GNOME"
msgstr "GNOME үшін дисктерді басқару қолданбасы"

#: data/org.gnome.DiskUtility.metainfo.xml.in:11
msgid "Disks provides an easy way to inspect, format, partition, and configure disks and block devices."
msgstr "Дисктер қолданбасы көмегімен дисктер мен блоктық құрылғыларды икемді түрде зерттеу, пішімдеу, бөлімдеу және баптауға болады."

#: data/org.gnome.DiskUtility.metainfo.xml.in:15
msgid "Using Disks, you can view SMART data, manage devices, benchmark physical disks, and image USB sticks."
msgstr "Дисктер қолданбасымен SMART деректерін қарау, құрылғыларды басқару, физикалық дисктерді сынау және USB тасушыларына бейнелерді жазуға болады."

#: data/org.gnome.DiskUtility.metainfo.xml.in:24
msgid "Partition and format disks"
msgstr "Дискілерді бөлімдерге бөлу және пішімдеу"

#: data/org.gnome.DiskUtility.metainfo.xml.in:28
msgid "Inspect drive speed and access time"
msgstr "Диск құрылғысының жылдамдығын және қол жеткізу уақытын тексеру"

#: data/org.gnome.DiskUtility.metainfo.xml.in:32
msgid "Manage your storage devices"
msgstr "Сақтау құрылғыларыңызды басқару"

