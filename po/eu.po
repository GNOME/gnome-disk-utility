msgid "Ignored, kept for compatibility"
msgstr "Ezikusi egin, bateragarritasuna bermatzeko mantendu da"

#: src/disks/gdu-application.c:184
msgid "Restore disk image"
msgstr "Berreskuratu disko-irudia"

