msgid "Select device"
msgstr "Pilih perangkat"

#: src/disks/gdu-application.c:181
msgid "Format selected device"
msgstr "Format perangkat yang dipilih"

#: src/disks/gdu-application.c:183
msgid "Show verbose logs, specify up to four times to increase log level"
msgstr "Tampilkan log rinci, tentukan sampai dengan empat kali untuk meningkatkan aras log"

#: src/disks/gdu-application.c:184
msgid "Ignored, kept for compatibility"
msgstr "Diabaikan, disimpan untuk kompatibilitas"

#: src/disks/gdu-application.c:185
msgid "Restore disk image"
msgstr "Pulihkan citra diska"

#: src/disks/gdu-application.c:215
msgid "--format-device must be used together with --block-device\n"
msgstr "--format-device mesti dipakai bersama dengan --block-device\n"

#: src/disks/gdu-application.c:221
msgid "--format-device must not be used together with --restore-disk-image"
msgstr "--format-device mesti dipakai bersama dengan --restore-disk-image"

