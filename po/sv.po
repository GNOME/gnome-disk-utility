#: src/disks/gdu-ata-smart-dialog.c:312
msgid "Number of Data Address Mark (DAM) errors (or) vendor-specific"
msgstr "Antal Data Address Mark-fel (DAM) (eller) tillverkarspecifika"

#. Translators: SMART attribute, see
#. * http://smartmontools.sourceforge.net/doc.html or the
#. * next string for a longer explanation.
#.
