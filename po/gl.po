#: data/gnome-disk-image-mounter.desktop.in:2
msgid "Disk Image Mounter"
msgstr "Montador de imaxes de discos"

#: data/gnome-disk-image-mounter.desktop.in:3
msgid "Mount/Write Disk Images"
msgstr "Montar/escribir imaxes de disco"

#: data/org.gnome.Disks.gschema.xml:6
msgid "Default location for the Create/Restore disk image dialogs"
msgstr "Ubicación predeterminada para os diálogos de Crear/restaurar imaxes de discos"

#: data/org.gnome.Disks.gschema.xml:7
msgid "Default location for the Create/Restore disk image dialogs. If blank the ~/Documents folder is used."
msgstr "Ubicación predeterminada para os diálogos de Crear/restaurar imaxes de discos. Se está en blanco, se usará o cartafol ~/Documentos."

#: data/org.gnome.Disks.gschema.xml:13
msgid "Initial state of the window"
msgstr "Estado inicial da xanela"

#: data/org.gnome.Disks.gschema.xml:14
msgid "A tuple containing the initial width, height and maximize state of the app window."
msgstr "Unha tupla que contén o ancho inicial, o alto e o estado de maximizar da xanela da aplicación."

#: data/org.gnome.Disks.gschema.xml:20
msgid "The number of samples the benchmark will include for the read/write test."
msgstr "O número de mostras que a prueba de rendimiento incluirá o test de lectura/escritura."

#: data/org.gnome.Disks.gschema.xml:24
msgid "The number of MiB (1048576 bytes) to read/write for each sample."
msgstr "O número de MiB (1048576 bytes) que leer/escribir en cada mostra."

#: data/org.gnome.Disks.gschema.xml:28
msgid "To enable or disable the write test."
msgstr "Para activar o desactivar o test de escritura."

#: data/org.gnome.Disks.gschema.xml:32
msgid "The number of samples the benchmark will do for the access time test."
msgstr "O número de mostras que a prueba de rendimiento hará para comprobar o tiempo de acceso."

