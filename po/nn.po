#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:144
msgid "Read Error Rate"
msgstr "Lesefeilrate"

#: src/disks/gduatasmartdialog.c:145
msgid ""
"Frequency of errors while reading raw data from the disk. A non-zero value "
"indicates a problem with either the disk surface or read/write heads"
msgstr ""
"Frekvens for feil under lesing av rådata frå disken. Ein ikkje-null verdi "
"indikerer eit problem med anten diskoverflata eller lese/skrive-hovuda"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:154
msgid "Throughput Performance"
msgstr "Gjennomstrøyming yting"

#: src/disks/gduatasmartdialog.c:155
msgid "Average efficiency of the disk"
msgstr "Gjennomsnittleg effektivitet for disken"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:162
msgid "Spinup Time"
msgstr "Spinup-tid"

#: src/disks/gduatasmartdialog.c:163
msgid "Time needed to spin up the disk"
msgstr "Tid som trengst for å spinne opp disken"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:170
msgid "Start/Stop Count"
msgstr "Start/stopp-teljing"

#: src/disks/gduatasmartdialog.c:171
msgid "Number of spindle start/stop cycles"
msgstr "Tal på start/stopp-syklusar for spindel"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:178
msgid "Reallocated Sector Count"
msgstr "Tømt sektor-teljing"

#: src/disks/gduatasmartdialog.c:179
msgid ""
"Count of remapped sectors. When the hard drive finds a read/write/"
"verification error, it marks the sector as “reallocated” and transfers data "
"to a special reserved area (spare area)"
msgstr ""
"Tal på omplasserte sektorar. Når harddisken finn ein lese-/skrive-/"
"verifiseringsfeil, vert sektoren merkt som «omplassert» og data vert flytta "
"til eit spesielt reservert område (reserveområde)"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:188
msgid "Read Channel Margin"
msgstr "Les kanalkant"

#: src/disks/gduatasmartdialog.c:189
msgid "Margin of a channel while reading data."
msgstr "Margin for ein kanal medan du les data."

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:196
msgid "Seek Error Rate"
msgstr "Søkjefeilrate"

#: src/disks/gduatasmartdialog.c:197
msgid "Frequency of errors while positioning"
msgstr "Hyppigheit av feil under posisjonering"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:204
msgid "Seek Timer Performance"
msgstr "Yting for søkjetid"

#: src/disks/gduatasmartdialog.c:205
msgid "Average efficiency of operations while positioning"
msgstr "Gjennomsnittleg effektivitet av operasjonar under posisjonering"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:212 src/disks/gduatasmartdialog.c:537
msgid "Power-On Hours"
msgstr "Oppstartstimer"

#: src/disks/gduatasmartdialog.c:213 src/disks/gduatasmartdialog.c:538
msgid "Number of hours elapsed in the power-on state"
msgstr "Tal på timar som har gått i på-tilstand"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:220
msgid "Spinup Retry Count"
msgstr "Spinup-forsøkstal"

#: src/disks/gduatasmartdialog.c:221
msgid "Number of retry attempts to spin up"
msgstr "Tal på forsøk til oppstart"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:228
msgid "Calibration Retry Count"
msgstr "Kalibreringsforsøk på nytt"

#: src/disks/gduatasmartdialog.c:229
msgid "Number of attempts to calibrate the device"
msgstr "Tal på forsøk til å kalibrere eininga"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:236
msgid "Power Cycle Count"
msgstr "Straumsyklus-teljing"

#: src/disks/gduatasmartdialog.c:237
msgid "Number of power-on events"
msgstr "Talet på oppstartshendingar"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:244
msgid "Soft read error rate"
msgstr "Mjuk lesefeilrate"

#: src/disks/gduatasmartdialog.c:246
msgid "Frequency of errors while reading from the disk"
msgstr "Frekvensen av feil under lesing frå disken"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:253
msgid "Reported Uncorrectable Errors"
msgstr "Rapporterte ukorrigerbare feil"

#: src/disks/gduatasmartdialog.c:254
msgid "Number of errors that could not be recovered using hardware ECC"
msgstr ""
"Talet på feil som ikkje kunne gjenopprettast ved hjelp av maskinvare-ECC"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:261
msgid "High Fly Writes"
msgstr "High Fly Skriv"

#: src/disks/gduatasmartdialog.c:262
msgid ""
"Number of times a recording head is flying outside its normal operating range"
msgstr ""
"Talet på gongar eit opptakshovud flyg utanfor sitt normale driftsområde"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:269
msgid "Airflow Temperature"
msgstr "Luftstraumstemperatur"

#: src/disks/gduatasmartdialog.c:270
msgid "Airflow temperature of the drive"
msgstr "Luftstraumtemperatur i drevet"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:277 src/disks/gduatasmartdialog.c:447
msgid "G-sense Error Rate"
msgstr "G-sense feilrate"

#: src/disks/gduatasmartdialog.c:278
msgid "Frequency of mistakes as a result of impact loads"
msgstr "Frekvens av feil som følgje av støytlastar"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:285 src/disks/gduatasmartdialog.c:504
msgid "Power-off Retract Count"
msgstr "Straum-av-tilbaketrekking-tal"

#: src/disks/gduatasmartdialog.c:286
msgid "Number of power-off or emergency retract cycles"
msgstr "Talet på straumav- eller nødtilbaketrekkingar"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:293 src/disks/gduatasmartdialog.c:480
msgid "Load/Unload Cycle Count"
msgstr "Laste/losse-syklustal"

#: src/disks/gduatasmartdialog.c:294
msgid "Number of cycles into landing zone position"
msgstr "Tal på syklusar inn i landingssona"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:301 src/disks/gduatasmartdialog.c:520
#: src/disks/ui/smart-dialog.ui:153
msgid "Temperature"
msgstr "Temperatur"

#: src/disks/gduatasmartdialog.c:302
msgid "Current internal temperature of the drive"
msgstr "Noverande indre temperatur i stasjonen"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:309
msgid "Hardware ECC Recovered"
msgstr "Maskinvare ECC gjenoppretta"

#: src/disks/gduatasmartdialog.c:310
msgid "Number of ECC on-the-fly errors"
msgstr "Talet på ECC-feil undervegs"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:317
msgid "Reallocation Count"
msgstr "Tildelingstal"

#: src/disks/gduatasmartdialog.c:318
msgid ""
"Number of remapping operations. The raw value of this attribute shows the "
"total number of (successful and unsuccessful) attempts to transfer data from "
"reallocated sectors to a spare area"
msgstr ""
"Tal på omskrivingar. Den rå verdien til dette attributtet viser det totale "
"talet på (vellukka og mislukka) forsøk på å overføre data frå omfordelte "
"sektorar til eit reserveområde"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:328
msgid "Current Pending Sector Count"
msgstr "Noverande tal på ventande sektorar"

#: src/disks/gduatasmartdialog.c:329
msgid ""
"Number of sectors waiting to be remapped. If the sector waiting to be "
"remapped is subsequently written or read successfully, this value is "
"decreased and the sector is not remapped. Read errors on the sector will not "
"remap the sector, it will only be remapped on a failed write attempt"
msgstr ""
"Talet på sektorar som ventar på å verte ommappa. Dersom sektoren som ventar "
"på å verte ommappa seinare vert skriven eller lesen på ein vellukka måte, "
"vert verdien redusert og sektoren vert ikkje ommappa. Lesefeil på sektoren "
"vil ikkje føre til ommapping av sektoren, han vert berre ommappa ved eit "
"mislukka skriveforsøk"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:340
msgid "Uncorrectable Sector Count"
msgstr "Uretteleg sektor-teljing"

#: src/disks/gduatasmartdialog.c:341
msgid ""
"The total number of uncorrectable errors when reading/writing a sector. A "
"rise in the value of this attribute indicates defects of the disk surface "
"and/or problems in the mechanical subsystem"
msgstr ""
"Det totale talet på ukorrigerbare feil ved lesing/skriving av ein sektor. "
"Ein auke i verdien for dette attributtet indikerer defektar i diskoverflata "
"og/eller problem i det mekaniske undersystemet"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:350
msgid "UDMA CRC Error Rate"
msgstr "UDMA CRC-feilrate"

#: src/disks/gduatasmartdialog.c:351
msgid "Number of CRC errors during UDMA mode"
msgstr "Tal på CRC-feil under UDMA-modus"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:358
msgid "Write Error Rate"
msgstr "Skrivefeilrate"

#: src/disks/gduatasmartdialog.c:359
msgid ""
"Number of errors while writing to disk (or) multi-zone error rate (or) "
"flying-height"
msgstr ""
"Talet på feil under skriving til disk (eller) fleirsonefeilrate (eller) "
"flygehøgd"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:366
msgid "Soft Read Error Rate"
msgstr "Mjuk lesefeilrate"

#: src/disks/gduatasmartdialog.c:367
msgid "Number of off-track errors"
msgstr "Tal på feil som ikkje følgjer sporet"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:374
msgid "Data Address Mark Errors"
msgstr "Datamarkeringar"

#: src/disks/gduatasmartdialog.c:375
msgid "Number of Data Address Mark (DAM) errors (or) vendor-specific"
msgstr "Tal på Data Address Mark (DAM)-feil (eller) leverandørspesifikk"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:382
msgid "Run Out Cancel"
msgstr "Avbryt køyring"

#: src/disks/gduatasmartdialog.c:383
msgid "Number of ECC errors"
msgstr "Talet på ECC-feil"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:390
msgid "Soft ECC correction"
msgstr "Mjuk ECC-korreksjon"

#: src/disks/gduatasmartdialog.c:391
msgid "Number of errors corrected by software ECC"
msgstr "Talet på feil som programvare ECC har retta"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
#. * or the next string for a longer explanation.
#.
#: src/disks/gduatasmartdialog.c:398
msgid "Thermal Asperity Rate"
msgstr "Varmekalibreringsrate"

#: src/disks/gduatasmartdialog.c:399
msgid "Number of Thermal Asperity Rate errors"
msgstr "Tal på Thermal Asperity Rate-feil"

#. Translators: SMART attribute, see http://smartmontools.sourceforge.net/doc.html
