msgid "Try changing some letters and numbers."
msgstr "Cobalah mengubah beberapa huruf dan angka."

#: src/disks/gdu-create-password-page.c:45 src/disks/gdu-create-password-page.c:49
msgctxt "Password hint"
msgid "Try changing the password a bit more."
msgstr "Cobalah mengubah kata sandi sedikit lagi."

#: src/disks/gdu-create-password-page.c:47
msgctxt "Password hint"
msgid "Try to avoid some of the words included in the password."
msgstr "Cobalah menghindari beberapa kata yang termasuk dalam kata sandi."

#: src/disks/gdu-create-password-page.c:51
msgctxt "Password hint"
msgid "Try to avoid common words."
msgstr "Cobalah menghindari kata-kata umum."

#: src/disks/gdu-create-password-page.c:53
msgctxt "Password hint"
msgid "Try to avoid reordering existing words."
msgstr "Cobalah menghindari mengatur ulang urutan kata yang ada."

#: src/disks/gdu-create-password-page.c:55
msgctxt "Password hint"
msgid "Try to use more numbers."
msgstr "Cobalah memakai lebih banyak angka."

#: src/disks/gdu-create-password-page.c:57
msgctxt "Password hint"
msgid "Try to use more uppercase letters."
msgstr "Cobalah memakai lebih banyak huruf besar."

#: src/disks/gdu-create-password-page.c:59
msgctxt "Password hint"
msgid "Try to use more lowercase letters."
msgstr "Cobalah memakai lebih banyak huruf kecil."

#: src/disks/gdu-create-password-page.c:61
msgctxt "Password hint"
msgid "Try to use more special characters, like punctuation."
msgstr "Cobalah memakai lebih banyak karakter khusus, seperti tanda baca."

#: src/disks/gdu-create-password-page.c:63
msgctxt "Password hint"
msgid "Try to use a mixture of letters, numbers and punctuation."
msgstr "Cobalah memakai campuran huruf, angka, dan tanda baca."

#: src/disks/gdu-create-password-page.c:65
msgctxt "Password hint"
msgid "Try to avoid repeating the same character."
msgstr "Cobalah menghindari pengulangan karakter yang sama."

#: src/disks/gdu-create-password-page.c:67
msgctxt "Password hint"
msgid "Try to avoid repeating the same type of character: you need to mix up letters, numbers and punctuation."
msgstr "Cobalah menghindari mengulang karakter bertipe sama: Anda perlu mencampur huruf, angka, dan tanda baca."

#: src/disks/gdu-create-password-page.c:69
msgctxt "Password hint"
msgid "Try to avoid sequences like 1234 or abcd."
msgstr "Cobalah menghindari urutan seperti 1234 atau abcd."

#: src/disks/gdu-create-password-page.c:71
msgctxt "Password hint"
msgid "Mix uppercase and lowercase and try to use a number or two."
msgstr "Campurlah huruf besar dan kecil dan cobalah memakai satu atau dua angka."

#: src/disks/gdu-create-password-page.c:73
msgctxt "Password hint"
msgid "Adding more letters, numbers and punctuation will make the password stronger."
msgstr "Menambahkan lebih banyak huruf, angka, dan tanda baca akan membuat kata sandi lebih kuat."

