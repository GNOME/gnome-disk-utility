#: data/gnome-disk-image-mounter.desktop.in:2
msgid "Disk Image Mounter"
msgstr "Disko-irudien muntatzailea"

#: data/gnome-disk-image-mounter.desktop.in:3
msgid "Mount/Write Disk Images"
msgstr "Muntatu/Idatzi disko-irudia"

#: data/org.gnome.Disks.gschema.xml:6
msgid "Default location for the Create/Restore disk image dialogs"
msgstr "Kokaleku lehenetsia disko-irudia sortzeko/leheneratzeko elkarrizketa-koadroentzako"

#: data/org.gnome.Disks.gschema.xml:7
msgid ""
"Default location for the Create/Restore disk image dialogs. If blank the ~/"
"Documents folder is used."
msgstr "Kokaleku lehenetsia disko-irudia sortzeko/leheneratzeko elkarrizketa-koadroentzako. Hutsik badago, ~/Dokumentuak karpeta erabiliko da."

#: data/org.gnome.Disks.gschema.xml:13
msgid "Initial state of the window"
msgstr "Leihoaren hasierako egoera"

#: data/org.gnome.Disks.gschema.xml:14
msgid ""
"A tuple containing the initial width, height and maximize state of the app "
"window."
msgstr "Aplikazio-leihoaren hasierako zabalera, altuera eta egoera maximizatua dituen tuplea."

#: data/org.gnome.Disks.gschema.xml:20
msgid ""
"The number of samples the benchmark will include for the read/write test."
msgstr "Errendimendu-probak izango duen lagin kopurua irakurtzeko/idazteko probarako."

#: data/org.gnome.Disks.gschema.xml:24
msgid "The number of MiB (1048576 bytes) to read/write for each sample."
msgstr "Lagin bakoitzerako irakustzeko/idazteko izango den MiB (1048576 byte) kopurua."

#: data/org.gnome.Disks.gschema.xml:28
msgid "To enable or disable the write test."
msgstr "Idazteko proba gaitzea edo desgaitzea."

#: data/org.gnome.Disks.gschema.xml:32
msgid "The number of samples the benchmark will do for the access time test."
msgstr "Errendimendu-probak atzitze-denboraren probarako egingo duen lagin kopurua."

