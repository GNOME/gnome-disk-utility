#: src/disks/gdu-application.c:98
msgid "Cancel running operations?"
msgstr "Прекратяване на текущите действия?"

#: src/disks/gdu-application.c:99
msgid ""
"Disks is performing one or more operations. Closing the app will cancel them."
msgstr ""
"Програмата извършва едно или повече действия. Затварянето ѝ ще ги прекрати."

#: src/disks/gdu-application.c:100
msgid "Close"
msgstr "Затваряне"

#: src/disks/gdu-application.c:145
#, c-format
msgid "Error opening %s: %s"
msgstr "Грешка при отваряне на „%s“: %s"

#: src/disks/gdu-application.c:151
#, c-format
msgid "Error looking up block device for %s"
msgstr "Грешка при заключване на блоковото устройство на „%s“"

#: src/disks/gdu-application.c:180
msgid "Select device"
msgstr "Избор на устройство"

#: src/disks/gdu-application.c:181
msgid "Format selected device"
msgstr "Форматиране на устройство"

#: src/disks/gdu-application.c:183
msgid "Show verbose logs, specify up to four times to increase log level"
msgstr ""
"Извеждане на подробни журнали. Повторете до 4 пъти за нарастваща подробност"

#: src/disks/gdu-application.c:184
msgid "Ignored, kept for compatibility"
msgstr "Прескача се, само за съвместимост"

#: src/disks/gdu-application.c:185
msgid "Restore disk image"
msgstr "Възстановяване на файл с образ"

#: src/disks/gdu-application.c:215
msgid "--format-device must be used together with --block-device\n"
msgstr "опцията „--format-device“ изисква „--block-device“\n"

#: src/disks/gdu-application.c:221
msgid "--format-device must not be used together with --restore-disk-image"
msgstr "опциите „--format-device“ и „--restore-disk-image“ са несъвместими"

