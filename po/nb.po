#: src/resources/ui/gdu-ata-smart-dialog.ui:80
msgid "Temperature"
msgstr "Temperatur"

#: src/disks/gdu-ata-smart-dialog.c:248
msgid "Current internal temperature of the drive"
msgstr "Nåværende indre temperatur i stasjonen"

