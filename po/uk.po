msgid "GNOME Disk Image Mounter"
msgstr "Монтування образів диска GNOME"

#: src/disks/gdu-application.c:97
msgid "Cancel running operations?"
msgstr "Скасувати поточні дії?"

#: src/disks/gdu-application.c:98
msgid ""
"Disks is performing one or more operations. Closing the app will cancel them."
msgstr ""
"«Диски» виконують одну або декілька дій. Закриття вікна програми призведе до "
"їхнього скасування."

#: src/disks/gdu-application.c:99
msgid "Close"
msgstr "Закрити"

#: src/disks/gdu-application.c:144
#, c-format
msgid "Error opening %s: %s"
msgstr "Помилка відкривання %s: %s"

#: src/disks/gdu-application.c:150
#, c-format
msgid "Error looking up block device for %s"
msgstr "Помилка знаходження блокового пристрою для %s"

#: src/disks/gdu-application.c:179
msgid "Select device"
msgstr "Виберіть пристрій"

#: src/disks/gdu-application.c:180
msgid "Format selected device"
msgstr "Форматувати вибраний пристрій"

#: src/disks/gdu-application.c:182
msgid "Show verbose logs, specify up to four times to increase log level"
msgstr ""
"Показати докладний журнал, вкажіть аж до чотирьох разів, щоб збільшити "
"рівень журналювання"

#: src/disks/gdu-application.c:183
msgid "Ignored, kept for compatibility"
msgstr "Буде проігноровано, зберігається для сумісності"

#: src/disks/gdu-application.c:184
msgid "Restore disk image"
msgstr "Відновити образ диска"

#: src/disks/gdu-application.c:214
msgid "--format-device must be used together with --block-device\n"
msgstr "--format-device потрібно використовувати з --block-device\n"

#: src/disks/gdu-application.c:220
msgid "--format-device must not be used together with --restore-disk-image"
msgstr "--format-device не можна поєднувати із --restore-disk-image"

